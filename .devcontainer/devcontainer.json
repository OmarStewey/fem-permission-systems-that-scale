{
  "name": "Node.js v20",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "VARIANT": "20",
      "NODE_VERSION": "20"
    }
  },
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "extensions": [
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode"
  ],
  "postCreateCommand": "npm install",
  "remoteUser": "vscode"
}
